{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "wong hook session-start --agent codex",
            "timeout": 30,
            "statusMessage": "Bringing in the wong brain",
            "additionalContextLimit": 10000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "wong hook session-end --agent codex",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "wong hook pre-tool-use --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "wong hook post-tool-use --agent codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
